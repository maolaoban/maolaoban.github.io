---
import BasicLayout from "../layouts/BasicLayout.astro";
import Button from "../components/Button.astro";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
---

<script>
  import { timeline, type TimelineDefinition } from "motion";

  const sequence = [
    [
      ".loaderRef",
      { opacity: [1, 0], pointerEvents: "none" },
      { easing: "ease-out" },
    ],
  ];

  timeline(sequence as TimelineDefinition);
</script>

<BasicLayout
  title="Bookmark Helper - 智能书签搜索"
  description="一款注重隐私的 Chrome 扩展，用自然语言搜索你的书签"
>
  <a
    href="/"
    class="text-white absolute bg-neutral-900 hover:bg-neutral-800 top-4 left-4 px-4 py-2 border-1 border-solid border-neutral-600 rounded-lg z-50"
    >Back</a
  >

  <main class="text-white m-auto p-4 max-w-4xl w-full pt-20">
    <!-- Hero -->
    <section class="text-center mb-16">
      <Image
        width="80"
        height="80"
        src="/icon/bookmark-helper.png"
        alt="Bookmark Helper"
        class="mx-auto mb-6 rounded-xl"
      />
      <h1 class="text-4xl font-bold mb-4">Bookmark Helper</h1>
      <p class="text-lg text-gray-400 mb-2">用自然语言搜索你的书签</p>
      <p class="text-sm text-gray-500">
        100% 本地运行 · 隐私优先 · 混合语义搜索
      </p>
    </section>

    <!-- Features -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-16">
      <div class="bg-darkslate-500 border border-darkslate-100 rounded-lg p-6">
        <h3 class="text-primary-100 font-bold mb-2 flex items-center gap-2">
          <Icon name="ri:lock-line" class="h-5" /> 完全本地
        </h3>
        <p class="text-sm text-gray-400">
          所有搜索在本地完成，无需云端 API，书签数据从不离开你的设备。
        </p>
      </div>

      <div class="bg-darkslate-500 border border-darkslate-100 rounded-lg p-6">
        <h3 class="text-primary-100 font-bold mb-2 flex items-center gap-2">
          <Icon name="ri:search-line" class="h-5" /> 混合搜索
        </h3>
        <p class="text-sm text-gray-400">
          结合向量语义搜索与 BM25 关键词搜索，精准理解你的意图。
        </p>
      </div>

      <div class="bg-darkslate-500 border border-darkslate-100 rounded-lg p-6">
        <h3 class="text-primary-100 font-bold mb-2 flex items-center gap-2">
          <Icon name="ri:database-2-line" class="h-5" /> 智能索引增强
        </h3>
        <p class="text-sm text-gray-400">
          浏览页面时自动提取标题、描述等元数据，丰富书签索引，提升搜索准确率。
        </p>
      </div>

      <div class="bg-darkslate-500 border border-darkslate-100 rounded-lg p-6">
        <h3 class="text-primary-100 font-bold mb-2 flex items-center gap-2">
          <Icon name="ri:global-line" class="h-5" /> 离线可用
        </h3>
        <p class="text-sm text-gray-400">
          首次加载模型后完全离线工作，支持 Chrome、Edge、Brave 等主流 Chromium 浏览器。
        </p>
      </div>
    </div>

    <!-- CTA -->
    <section class="text-center">
      <a
        href="https://github.com/maolaoban/bookmark-helper"
        target="_blank"
        rel="noopener noreferrer"
      >
        <Button>
          <span class="flex items-center gap-2">
            <Icon name="ri:github-fill" class="h-5" /> GitHub
          </span>
        </Button>
      </a>
      <p class="text-xs text-gray-500 mt-4">v1.0.0 · 开源免费</p>
    </section>
  </main>
</BasicLayout>
